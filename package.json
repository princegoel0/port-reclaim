{
  "name": "port-reclaim",
  "version": "0.2.0",
  "description": "Safely reclaim local ports from stale development processes.",
  "author": "princegoel0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/princegoel0/port-reclaim.git"
  },
  "bugs": {
    "url": "https://github.com/princegoel0/port-reclaim/issues"
  },
  "homepage": "https://github.com/princegoel0/port-reclaim#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "port-reclaim": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/tests/process.test.js dist/tests/args.test.js dist/tests/config.test.js dist/tests/cli.test.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "cli",
    "port",
    "process",
    "developer-tools",
    "cross-platform"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "pid-cwd": "^1.2.0"
  }
}
